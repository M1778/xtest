// Package layout marker for finn: it is detected by presence, not parsed.
// There is no executable re-export syntax in Fin; the API lives in
// src/xtest.fin (namespace fin) and the root xtest.fin forwards it.
// Consumers write: import { TestStats, xtest_new } from xtest::fin;
