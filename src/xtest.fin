// xtest: non-aborting checks, registration-indexed cases, and checked JUnit output.
import { len, concat, clone, equals, to_chars, from_chars } from strings::std;

namespace fin {

#[llvm_name="snprintf"]
@define xtest_snprintf(buf: string, size: ulong, fmt: string, ...) <int>;
#[llvm_name="calloc"]
@define xtest_calloc(count: ulong, size: ulong) <string>;
#[llvm_name="free"]
@define xtest_cfree(p: string) <noret>;
#[llvm_name="fopen"]
@define xtest_fopen(path: string, mode: string) <&void>;
#[llvm_name="fputs"]
@define xtest_fputs(text: string, stream: &void) <int>;
#[llvm_name="fflush"]
@define xtest_fflush(stream: &void) <int>;
#[llvm_name="fclose"]
@define xtest_fclose(stream: &void) <int>;

#[export]
pub struct TestStats {
    pub:
        // Suite is borrowed; all arrays and their strings are owned by this value.
        // Do not copy owning stats. current_case aliases cases[current_id].
        suite <string>,
        passes <int>,
        failures <int>,
        current_case <string>,
        current_id <int>,
        case_count <int>,
        failed_case_count <int>,
        capacity <int>,
        cases <[string]>,
        case_failures <[int]>,
        case_messages <[string]>,
}

#[export]
pub fun xtest_new(suite: string) <TestStats> {
    printf("== %s ==\n", suite);
    return TestStats{
        suite: suite, passes: 0, failures: 0, current_case: "", current_id: -1,
        case_count: 0, failed_case_count: 0, capacity: 4,
        cases: new [string, 4]{}, case_failures: new [int, 4]{},
        case_messages: new [string, 4]{}
    };
}

// Grow only xtest-owned arrays; stdlib collection internals are not involved.
fun xtest_reserve(stats: &TestStats) <noret> {
    if (stats.case_count < stats.capacity) { return; }
    let capacity <int> = stats.capacity * 2;
    if (capacity < 4) { capacity = 4; }
    let names <[string]> = new [string, capacity]{};
    let counts <[int]> = new [int, capacity]{};
    let messages <[string]> = new [string, capacity]{};
    for (let i <int> = 0; i < stats.case_count; i++) {
        names[i] = stats.cases[i];
        counts[i] = stats.case_failures[i];
        messages[i] = stats.case_messages[i];
    }
    if (stats.cases != null) { delete stats.cases; }
    if (stats.case_failures != null) { delete stats.case_failures; }
    if (stats.case_messages != null) { delete stats.case_messages; }
    stats.cases = names;
    stats.case_failures = counts;
    stats.case_messages = messages;
    stats.capacity = capacity;
}

// Registration is identity: two equal labels always describe distinct cases.
// The caller may mutate or free name immediately after this call.
#[export]
pub fun xtest_case(stats: &TestStats, name: string) <noret> {
    xtest_reserve(stats);
    let owned <string> = clone(name);
    let id <int> = stats.case_count;
    stats.cases[id] = owned;
    stats.case_failures[id] = 0;
    // finc O0 may evaluate an indexed assignment's RHS twice: allocate first.
    let messages <string> = clone("");
    stats.case_messages[id] = messages;
    stats.case_count += 1;
    stats.current_id = id;
    stats.current_case = owned;
    printf("  - %s\n", owned);
}

#[export]
pub fun xtest_param(base: string, i: int) <string> {
    let n <ulong> = cast<ulong>(len(base) + 24);
    let buf <string> = xtest_calloc(n, cast<ulong>(1));
    xtest_snprintf(buf, n, "%s[%d]", base, i);
    return buf;
}

// Idempotent cleanup, including backing arrays. suite remains borrowed.
#[export]
pub fun xtest_free(stats: &TestStats) <noret> {
    for (let i <int> = 0; i < stats.case_count; i++) {
        xtest_cfree(stats.cases[i]);
        xtest_cfree(stats.case_messages[i]);
    }
    if (stats.cases != null) { delete stats.cases; }
    if (stats.case_failures != null) { delete stats.case_failures; }
    if (stats.case_messages != null) { delete stats.case_messages; }
    // Fin rejects assigning null directly to an array; a zero-initialized
    // value supplies empty handles without allocating replacement buffers.
    let empty <TestStats> = TestStats{};
    stats.cases = empty.cases;
    stats.case_failures = empty.case_failures;
    stats.case_messages = empty.case_messages;
    stats.current_case = "";
    stats.current_id = -1;
    stats.case_count = 0;
    stats.failed_case_count = 0;
    stats.capacity = 0;
    stats.passes = 0;
    stats.failures = 0;
}

fun xtest_record(stats: &TestStats, ok: bool, detail: string) <noret> {
    // Assertions before any registration share a single implicit case.
    if (stats.current_id < 0) { xtest_case(stats, "(unnamed)"); }
    if (ok) {
        stats.passes += 1;
        return;
    }
    let id <int> = stats.current_id;
    stats.failures += 1;
    if (stats.case_failures[id] == 0) { stats.failed_case_count += 1; }
    let previous <string> = stats.case_messages[id];
    let joined <string> = "";
    if (stats.case_failures[id] == 0) {
        joined = clone(detail);
    } else {
        let separated <string> = concat(previous, "\n");
        joined = concat(separated, detail);
        xtest_cfree(separated);
    }
    xtest_cfree(previous);
    stats.case_messages[id] = joined;
    stats.case_failures[id] += 1;
    printf("    FAIL [%s]: %s\n", stats.current_case, detail);
}

#[export]
pub fun xtest_check(stats: &TestStats, cond: bool, msg: string) <noret> {
    xtest_record(stats, cond, msg);
}
#[export]
pub fun xtest_check_true(stats: &TestStats, cond: bool, msg: string) <noret> {
    xtest_record(stats, cond, msg);
}
#[export]
pub fun xtest_check_false(stats: &TestStats, cond: bool, msg: string) <noret> {
    xtest_record(stats, !cond, msg);
}
#[export]
pub fun xtest_check_eq_int(stats: &TestStats, actual: int, expected: int, msg: string) <noret> {
    if (actual == expected) { xtest_record(stats, true, msg); return; }
    let n <ulong> = cast<ulong>(len(msg) + 96);
    let buf <string> = xtest_calloc(n, cast<ulong>(1));
    xtest_snprintf(buf, n, "%s -- expected %d, got %d", msg, expected, actual);
    xtest_record(stats, false, buf);
    xtest_cfree(buf);
}
#[export]
pub fun xtest_check_ne_int(stats: &TestStats, actual: int, unexpected: int, msg: string) <noret> {
    if (actual != unexpected) { xtest_record(stats, true, msg); return; }
    let n <ulong> = cast<ulong>(len(msg) + 96);
    let buf <string> = xtest_calloc(n, cast<ulong>(1));
    xtest_snprintf(buf, n, "%s -- unexpectedly equal (%d)", msg, actual);
    xtest_record(stats, false, buf);
    xtest_cfree(buf);
}
#[export]
pub fun xtest_check_eq_bool(stats: &TestStats, actual: bool, expected: bool, msg: string) <noret> {
    let a <int> = 0;
    let e <int> = 0;
    if (actual) { a = 1; }
    if (expected) { e = 1; }
    xtest_check_eq_int(stats, a, e, msg);
}

// Null normalizes to the empty string for this compatibility wrapper.
#[export]
pub fun xtest_check_eq_str(stats: &TestStats, actual: string, expected: string, msg: string) <noret> {
    let a <string> = actual;
    let e <string> = expected;
    if (a == null) { a = ""; }
    if (e == null) { e = ""; }
    if (equals(a, e)) { xtest_record(stats, true, msg); return; }
    let n <ulong> = cast<ulong>(len(msg) + len(a) + len(e) + 96);
    let buf <string> = xtest_calloc(n, cast<ulong>(1));
    xtest_snprintf(buf, n, "%s -- expected \"%s\", got \"%s\"", msg, e, a);
    xtest_record(stats, false, buf);
    xtest_cfree(buf);
}
#[export]
pub fun xtest_check_approx(stats: &TestStats, actual: double, expected: double, eps: double, msg: string) <noret> {
    let diff <double> = actual - expected;
    let zero <double> = cast<double>(0);
    if (diff < zero) { diff = zero - diff; }
    if (diff <= eps) { xtest_record(stats, true, msg); return; }
    let n <ulong> = cast<ulong>(len(msg) + 160);
    let buf <string> = xtest_calloc(n, cast<ulong>(1));
    xtest_snprintf(buf, n, "%s -- expected %g (+/-%g), got %g", msg, expected, eps, actual);
    xtest_record(stats, false, buf);
    xtest_cfree(buf);
}

#[export]
pub fun xtest_passes(stats: &TestStats) <int> { return stats.passes; }
#[export]
pub fun xtest_failures(stats: &TestStats) <int> { return stats.failures; }
#[export]
pub fun xtest_case_count(stats: &TestStats) <int> { return stats.case_count; }
#[export]
pub fun xtest_summary(stats: &TestStats) <int> {
    printf("== %s: %d passed, %d failed (%d cases) ==\n",
           stats.suite, stats.passes, stats.failures, stats.case_count);
    if (stats.failures > 0) {
        printf("Failed cases:\n");
        for (let i <int> = 0; i < stats.case_count; i++) {
            if (stats.case_failures[i] > 0) { printf("  x %s\n", stats.cases[i]); }
        }
        return 1;
    }
    return 0;
}

// One bounded output allocation, at most six bytes per input byte.
// XML 1.0 forbids C0 controls except tab/newline/CR; replace them with '?'.
// Attribute whitespace is represented numerically to preserve exact readback.
fun xtest_xml_escape(s: string) <string> {
    let count <int> = len(s);
    blame count <= 357913940, "XML value too large";
    let bytes <[char]> = to_chars(s);
    let output <[char]> = new [char, count * 6 + 1]{};
    // One shared entity table avoids allocating per escaped character.
    let entities <[char]> = to_chars("&amp;&lt;&gt;&quot;&#9;&#10;&#13;");
    let used <int> = 0;
    for (let i <int> = 0; i < count; i++) {
        let c <char> = bytes[i];
        let start <int> = 0;
        let size <int> = 0;
        if (c == '&') { start = 0; size = 5; }
        else if (c == '<') { start = 5; size = 4; }
        else if (c == '>') { start = 9; size = 4; }
        else if (c == '"') { start = 13; size = 6; }
        else if (c == '\t') { start = 19; size = 4; }
        else if (c == '\n') { start = 23; size = 5; }
        else if (c == '\r') { start = 28; size = 5; }
        else if (cast<int>(c) >= 0 && cast<int>(c) < 32) { c = '?'; }
        if (size > 0) {
            for (let j <int> = 0; j < size; j++) {
                output[used] = entities[start + j];
                used++;
            }
        } else {
            output[used] = c;
            used++;
        }
    }
    let result <string> = from_chars(output, 0, used);
    delete entities;
    delete output;
    delete bytes;
    return result;
}

// Stream the report instead of repeatedly copying the entire document.
// Always close after opening, even when writing/flushing fails.
#[export]
pub fun xtest_junit(stats: &TestStats, path: string) <int> {
    if (path == null) { return 1; }
    let stream <&void> = xtest_fopen(path, "wb");
    if (stream == null) { return 1; }
    let failed <bool> = false;
    let suite <string> = xtest_xml_escape(stats.suite);
    let n <ulong> = cast<ulong>(len(suite) + 160);
    let header <string> = xtest_calloc(n, cast<ulong>(1));
    xtest_snprintf(header, n,
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuite name=\"%s\" tests=\"%d\" failures=\"%d\">\n",
        suite, stats.case_count, stats.failed_case_count);
    if (xtest_fputs(header, stream) < 0) { failed = true; }
    xtest_cfree(header);
    xtest_cfree(suite);
    for (let i <int> = 0; i < stats.case_count; i++) {
        let name <string> = xtest_xml_escape(stats.cases[i]);
        if (xtest_fputs("  <testcase name=\"", stream) < 0) { failed = true; }
        if (xtest_fputs(name, stream) < 0) { failed = true; }
        xtest_cfree(name);
        if (stats.case_failures[i] > 0) {
            let message <string> = xtest_xml_escape(stats.case_messages[i]);
            if (xtest_fputs("\"><failure message=\"", stream) < 0) { failed = true; }
            if (xtest_fputs(message, stream) < 0) { failed = true; }
            if (xtest_fputs("\"/></testcase>\n", stream) < 0) { failed = true; }
            xtest_cfree(message);
        } else {
            if (xtest_fputs("\"/>\n", stream) < 0) { failed = true; }
        }
    }
    if (xtest_fputs("</testsuite>\n", stream) < 0) { failed = true; }
    if (xtest_fflush(stream) != 0) { failed = true; }
    if (xtest_fclose(stream) != 0) { failed = true; }
    if (failed) { return 1; }
    return 0;
}

}
